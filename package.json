{
  "name": "genesis-fellowship-boilerplate",
  "version": "1.0.0",
  "private": true,
  "description": "Genesis Tech Studios // 12-Week Fellowship & Production Residency Monorepo",
  "author": "Genesis Tech Studios <talent@buildgenesis.in>",
  "homepage": "https://www.buildgenesis.in/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Genesis-Tech-Studios/fellowship-boilerplate.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:concurrency": "pnpm --filter @genesis/api test:concurrency",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,sol,json}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
